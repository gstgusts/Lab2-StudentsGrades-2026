<Window x:Class="Lab4.WpfStudents.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab4.WpfStudents"
        xmlns:viewModels="clr-namespace:Lab4.WpfStudents.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewModels:StudentListViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Label Width="80">Code:</Label>
                <TextBox Width="220" Text="{Binding Code, Mode=TwoWay}"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="80">Name:</Label>
                <TextBox Width="220" Text="{Binding Name, Mode=TwoWay}"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Width="80">Surname:</Label>
                <TextBox Width="220" Text="{Binding Surname, Mode=TwoWay}"></TextBox>
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="Search" Margin="0,10,0,0" Width="100" Command="{Binding SearchStudentCommand}"/>
            <Label>Students</Label>
            <DataGrid AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Students, Mode=OneWay}"
                      SelectedItem="{Binding SelectedStudent, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Width="100" Binding="{Binding Code}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Name" Width="100" Binding="{Binding Name}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Surname" Width="100" Binding="{Binding Surname}"></DataGridTextColumn>
                    </DataGrid.Columns>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SelectStudentCommand}"></i:InvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
            </DataGrid>
            <TextBlock Text="No students found." Visibility="{Binding IsCollectionEmpty, Converter={StaticResource EmptyToVisibilityConverter}}"></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <Label>Grades</Label>
            <DataGrid AutoGenerateColumns="False" x:Name="LstGrades"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding Grades, Mode=OneWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Subject" Width="100" Binding="{Binding Subject.Name}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Grade" Width="100" Binding="{Binding Value}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
